    "seed:catalog": "node scripts/seed-products.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mongodb": "^7.9.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.12"
  }
}
